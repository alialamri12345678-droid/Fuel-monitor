#include "FlowMeter.h"
#include "../../config/Config.h"
#include "../../utils/Logger.h"
#include "../../utils/ErrorHandler.h"

#include <esp_adc_cal.h>

static const char* TAG = "FlowMeter";

// ADC calibration characteristics (populated in begin())
static esp_adc_cal_characteristics_t _adcChars;
static bool _adcCalValid = false;

FlowMeter::FlowMeter()
    : _rawADC(0),
      _voltage(0.0f),
      _currentMA(0.0f),
      _currentMA_raw(0.0f),
      _flowRate(0.0f),
      _sensorValid(false),
      _filterInitialized(false)
{
}

bool FlowMeter::begin()
{
    LOG_INFO(TAG, "Initializing ADC on GPIO %d", ADC_FLOW_PIN);

    // Configure ADC resolution and attenuation
    analogReadResolution(ADC_RESOLUTION_BITS);
    analogSetAttenuation(ADC_ATTENUATION);

    // Configure specific pin attenuation
    analogSetPinAttenuation(ADC_FLOW_PIN, ADC_ATTENUATION);

    // Characterize ADC for voltage calibration
    // This uses factory-burned eFuse calibration data if available
    esp_adc_cal_value_t calType = esp_adc_cal_characterize(
        ADC_UNIT_1,
        ADC_ATTEN_DB_12,
        ADC_WIDTH_BIT_12,
        1100,           // Default Vref (mV) — overridden by eFuse if available
        &_adcChars
    );

    if (calType == ESP_ADC_CAL_VAL_EFUSE_TP)
    {
        LOG_INFO(TAG, "ADC calibration: Two-Point eFuse");
        _adcCalValid = true;
    }
    else if (calType == ESP_ADC_CAL_VAL_EFUSE_VREF)
    {
        LOG_INFO(TAG, "ADC calibration: Vref eFuse");
        _adcCalValid = true;
    }
    else
    {
        LOG_WARNING(TAG, "ADC calibration: Default Vref (no eFuse data)");
        _adcCalValid = true;   // Still usable, just less accurate
    }

    // Perform a test read
    int testRead = analogRead(ADC_FLOW_PIN);
    LOG_INFO(TAG, "ADC test read: %d", testRead);

    if (testRead < 0)
    {
        LOG_ERROR(TAG, "ADC read failed!");
        ErrorHandler::setError(SystemError::ERROR_ADC_FAILURE);
        return false;
    }

    LOG_INFO(TAG, "ADC initialized successfully");
    LOG_INFO(TAG, "  Shunt Resistor: %.0f Ohm", SHUNT_RESISTOR_OHMS);
    LOG_INFO(TAG, "  Current Range: %.1f - %.1f mA",
             FLOW_MIN_CURRENT, FLOW_MAX_CURRENT);
    LOG_INFO(TAG, "  Flow Range: %.1f - %.1f L/min",
             FLOW_MIN_RATE, FLOW_MAX_RATE);

    ErrorHandler::clearError(SystemError::ERROR_ADC_FAILURE);
    return true;
}

void FlowMeter::update()
{
    // 1. Read raw ADC value (multi-sample average for stability)
    uint32_t adcSum = 0;
    static constexpr int NUM_SAMPLES = 16;

    for (int i = 0; i < NUM_SAMPLES; i++)
    {
        adcSum += analogRead(ADC_FLOW_PIN);
    }

    _rawADC = static_cast<int>(adcSum / NUM_SAMPLES);

    // 2. Convert to voltage using calibrated characteristics
    _voltage = adcToVoltage(_rawADC);

    // 3. Convert voltage to current (mA)
    _currentMA_raw = voltageToCurrent(_voltage);

    // 4. Apply EMA filter
    _currentMA = applyFilter(_currentMA_raw);

    // 5. Validate sensor range
    _sensorValid = validateSensor(_currentMA);

    // 6. Calculate flow rate (only if sensor is valid)
    if (_sensorValid)
    {
        _flowRate = currentToFlowRate(_currentMA);

        // Clamp to zero if below minimum flow threshold
        if (_flowRate < 0.0f)
        {
            _flowRate = 0.0f;
        }

        ErrorHandler::clearError(SystemError::ERROR_SENSOR_OUT_OF_RANGE);
    }
    else
    {
        _flowRate = 0.0f;
        ErrorHandler::setError(SystemError::ERROR_SENSOR_OUT_OF_RANGE);
    }
}

// ============================================================
//  Getters
// ============================================================

float FlowMeter::getCurrentMilliAmps() const
{
    return _currentMA;
}

float FlowMeter::getFlowRate() const
{
    return _flowRate;
}

int FlowMeter::getRawADC() const
{
    return _rawADC;
}

float FlowMeter::getVoltage() const
{
    return _voltage;
}

bool FlowMeter::isValid() const
{
    return _sensorValid;
}

// ============================================================
//  Private — Conversion Functions
// ============================================================

float FlowMeter::adcToVoltage(int adcValue) const
{
    if (_adcCalValid)
    {
        // Use ESP32 calibrated ADC conversion (returns millivolts)
        uint32_t voltageMV = esp_adc_cal_raw_to_voltage(
            adcValue, &_adcChars);
        return voltageMV / 1000.0f;
    }
    else
    {
        // Fallback: linear conversion
        return (static_cast<float>(adcValue) / ADC_MAX_VALUE)
               * ADC_REFERENCE_VOLTAGE;
    }
}

float FlowMeter::voltageToCurrent(float voltage) const
{
    // Ohm's law: I = V / R
    // Current(mA) = (Voltage / Resistance) × 1000
    return (voltage / SHUNT_RESISTOR_OHMS) * 1000.0f;
}

float FlowMeter::currentToFlowRate(float currentMA) const
{
    // Linear mapping:
    //   4mA  → FLOW_MIN_RATE
    //   20mA → FLOW_MAX_RATE
    //
    // FlowRate = ((I - Imin) / (Imax - Imin)) * (Fmax - Fmin) + Fmin

    float normalized = (currentMA - FLOW_MIN_CURRENT)
                     / (FLOW_MAX_CURRENT - FLOW_MIN_CURRENT);

    float flowRate = normalized * (FLOW_MAX_RATE - FLOW_MIN_RATE)
                   + FLOW_MIN_RATE;

    return flowRate;
}

float FlowMeter::applyFilter(float rawValue)
{
    if (!_filterInitialized)
    {
        // Seed filter with first reading
        _currentMA = rawValue;
        _filterInitialized = true;
        return rawValue;
    }

    // Exponential Moving Average:
    //   filtered = alpha * raw + (1 - alpha) * previous
    _currentMA = FLOW_EMA_ALPHA * rawValue
               + (1.0f - FLOW_EMA_ALPHA) * _currentMA;

    return _currentMA;
}

bool FlowMeter::validateSensor(float currentMA) const
{
    // Wire break detection: current too low
    if (currentMA < SENSOR_WIRE_BREAK_MA)
    {
        return false;
    }

    // Short circuit detection: current too high
    if (currentMA > SENSOR_SHORT_CIRCUIT_MA)
    {
        return false;
    }

    return true;
}
